# UDAAN environment template. Copy to .env in the project root (or backend/)
# and fill only what you use. The backend loads those files automatically.
# NEVER commit real secrets.

# --- Core ---
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./udaan.db
# Comma-separated allow-list. Never use "*" with credentialed CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional email delivery for parent notifications ---
# In-app notifications always work. Email is attempted only when both
# EMAIL_NOTIFICATIONS_ENABLED=true and SMTP_HOST are configured.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UDAAN <no-reply@udaan.local>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=8

# --- Evidence-based parent alert thresholds ---
# A single wrong answer never triggers an alert. Lowering these values makes
# alerts more sensitive; keep the evidence requirements realistic.
PARENT_ALERT_WINDOW_DAYS=21
PARENT_ALERT_MIN_ATTEMPTS=6
PARENT_ALERT_LOW_MASTERY=0.45
PARENT_ALERT_REPEATED_WRONG=3
PARENT_ALERT_NO_IMPROVEMENT_SESSIONS=3
PARENT_ALERT_DECLINE_DELTA=0.25
PARENT_ALERT_COOLDOWN_HOURS=24
PARENT_ALERT_MAX_PER_RUN=2

# --- Parent messaging safety limit (per parent, rolling 24 hours) ---
PARENT_MESSAGES_MAX_PER_DAY=20

# --- Parent invitation / onboarding safety (Phase 3) ---
PARENT_INVITATION_EXPIRE_DAYS=7
PARENT_INVITATION_MAX_ACTIVE=3
PARENT_INVITATION_MAX_ATTEMPTS=5
PARENT_INVITATION_MIN_INTERVAL_SECONDS=20
PARENT_INVITE_RATE_WINDOW_SECONDS=60
PARENT_INVITE_RATE_MAX_REQUESTS=30

# --- Phase 5: ParentConnect weekly progress reports ---
# Reports run every Saturday at 09:00 Asia/Kolkata (fixed UTC+05:30, no DST).
# Enabling this starts an in-process scheduler; it is safe with multiple
# instances because a database lock guarantees a single run per week.
PARENT_CONNECT_SCHEDULER_ENABLED=true
PARENT_CONNECT_SCHEDULE_HOUR=9
PARENT_CONNECT_SCHEDULE_MINUTE=0
PARENT_CONNECT_TIMEZONE_OFFSET_MINUTES=330
PARENT_CONNECT_SCHEDULER_POLL_SECONDS=60
PARENT_CONNECT_JOB_LEASE_MINUTES=30
PARENT_CONNECT_MAX_DELIVERY_RETRIES=3

# Contact OTP + secure public report links.
PARENT_CONNECT_OTP_EXPIRE_MINUTES=10
PARENT_CONNECT_OTP_MAX_ATTEMPTS=5
PARENT_CONNECT_OTP_RESEND_SECONDS=60
PARENT_CONNECT_OTP_LENGTH=6
PARENT_CONNECT_REPORT_LINK_DAYS=14
# Public frontend origin used inside email/SMS report links (?report_token=...).
PARENT_CONNECT_PUBLIC_APP_URL=http://localhost:5173

# Email provider for reports and contact OTPs: disabled | smtp | resend | auto.
# "auto" (or blank) picks resend when RESEND_API_KEY is set, then smtp when
# SMTP_HOST is set, otherwise disabled.
# Missing credentials always report "not_configured"; nothing is faked as sent.
PARENT_CONNECT_EMAIL_PROVIDER=auto
PARENT_CONNECT_EMAIL_FROM=UDAAN <no-reply@udaan.local>
# Resend: RESEND_FROM_EMAIL must be a verified sender. The sandbox sender
# "onboarding@resend.dev" only delivers to the Resend account owner's own
# address; verify a domain at https://resend.com/domains to reach parents.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_TIMEOUT_SECONDS=10

# SMS provider for contact OTPs and concise weekly summaries:
# disabled | msg91 | twilio. MSG91 flow templates must be DLT-approved and use
# the variable names OTP, LINK, and MESSAGE where applicable.
PARENT_CONNECT_SMS_PROVIDER=disabled
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TIMEOUT_SECONDS=10

# --- Frontend (Vite) ---
# Leave unset in local development so Vite proxies /api to the backend.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
